<Window x:Class="prak3_var4_Vysotskiy.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Оформление доставки" Height="800" Width="1050"
 MinHeight="650" MinWidth="900" WindowStartupLocation="CenterScreen"
 Background="#F8FAFC" FontFamily="Segoe UI" FontSize="14">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#172554" Padding="20">
            <TextBlock Text="Оформление доставки" Foreground="White" FontSize="25" FontWeight="Bold"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#E2E8F0" Padding="13">
            <TextBlock Text="Предварительная стоимость: 450 ₽" FontSize="16" FontWeight="SemiBold"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22">
                <Border Background="White" Padding="16" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Отправитель" FontWeight="SemiBold"/>
                            <TextBox Height="30" Margin="0,5,0,10"/>
                            <TextBlock Text="Телефон отправителя"/>
                            <TextBox Height="30" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Получатель" FontWeight="SemiBold"/>
                            <TextBox Height="30" Margin="0,5,0,10"/>
                            <TextBlock Text="Телефон получателя"/>
                            <TextBox Height="30" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="White" Padding="16" CornerRadius="10" Margin="0,14,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Город"/>
                            <TextBox Height="30" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0">
                            <TextBlock Text="Улица"/>
                            <TextBox Height="30" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0">
                            <TextBlock Text="Дом"/>
                            <TextBox Height="30" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="8,0">
                            <TextBlock Text="Квартира"/>
                            <TextBox Height="30" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="8,0,0,0">
                            <TextBlock Text="Дата доставки"/>
                            <DatePicker Height="30" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,12">
                    <TextBlock Text="Способ доставки:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <RadioButton Content="До двери" GroupName="Delivery" IsChecked="True" Margin="0,0,20,0"/>
                    <RadioButton Content="До пункта выдачи" GroupName="Delivery"/>
                </StackPanel>
                <TextBlock Text="Параметры посылки" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <WrapPanel Background="#EFF6FF" Margin="0,0,0,14">
                    <CheckBox Content="Хрупкое" Margin="12"/>
                    <CheckBox Content="Не переворачивать" Margin="12"/>
                    <CheckBox Content="Позвонить заранее" Margin="12"/>
                    <CheckBox Content="Нужна упаковка" Margin="12"/>
                    <CheckBox Content="Страхование" Margin="12"/>
                </WrapPanel>
                <TextBlock Text="Комментарий курьеру"/>
                <TextBox Height="75" Margin="0,5,0,14" AcceptsReturn="True" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Оформить" Width="130" Height="38" Background="#2563EB" Foreground="White" Margin="0,0,10,0"/>
                    <Button Content="Отмена" Width="110" Height="38"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
